# =============================================================================
# Primary LLM API Key (Required — used for Research, Ingestion & Fallback)
# Get your key from: https://aistudio.google.com/app/api_keys
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# =============================================================================
# Multi-Provider LLM Keys (Optional — automatically activated when present)
# If omitted, the ModelRouter transparently falls back to Gemini.
# =============================================================================
# Anthropic Claude — recommended for LinkedIn & YouTube editorial voice (FR/EN)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — recommended for X threads & cross-family editorial critique
# OPENAI_API_KEY=your_openai_api_key_here

# xAI Grok — optional alternative for X/Twitter native threads
# XAI_API_KEY=your_xai_api_key_here

# Semantic Scholar — optional for higher academic search rate limits
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# alphaXiv — optional Bearer key for extended overview/API access (MCP: https://api.alphaxiv.org/mcp/v1)
# ALPHAXIV_API_KEY=your_alphaxiv_api_key_here

# OpenAlex — optional email for faster "polite pool" academic API access
# OPENALEX_EMAIL=your_email@example.com

# =============================================================================
# Optional Per-Role Model Overrides (LiteLLM format or Gemini model name)
# =============================================================================
# MODEL_OUTLINE=gemini-2.5-pro
# MODEL_RESEARCH=gemini-2.5-flash
# MODEL_VISUAL=gemini-2.5-pro
# MODEL_LINKEDIN=anthropic/claude-sonnet-4-5-20250929
# MODEL_X=openai/gpt-4.1
# MODEL_YOUTUBE=anthropic/claude-sonnet-4-5-20250929
# MODEL_NEWSLETTER=anthropic/claude-sonnet-4-5-20250929
# MODEL_FACT_CHECKER=gemini-2.5-pro
# MODEL_EDITORIAL_CRITIC=openai/gpt-4.1
# MODEL_REFINER=anthropic/claude-sonnet-4-5-20250929

# =============================================================================
# Gradio UI Network & Authentication Security
# =============================================================================
# Defaults to 127.0.0.1 (local-only). Never expose on 0.0.0.0 without auth!
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
# GRADIO_AUTH_USER=admin
# GRADIO_AUTH_PASSWORD=change_me_strong_password
